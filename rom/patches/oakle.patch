diff -ruN pokeyellow-pristine/engine/oakle/oakle_party.asm src/engine/oakle/oakle_party.asm
--- pokeyellow-pristine/engine/oakle/oakle_party.asm	1970-01-01 12:00:00
+++ src/engine/oakle/oakle_party.asm	2026-10-13 10:24:17
@@ -0,0 +1,238 @@
+; Oakle: daily config (the web page overwrites these bytes in the ROM before boot) and new-game setup.
+; Lives in bank3 next to _AddPartyMon so it can reuse AddPartyMon_WriteMovePP.
+
+DEF OAKLE_CFG_TRAINER_NO EQU 6  ; Oak trainer number 1-3 (picks his starter)
+DEF OAKLE_CFG_DAY        EQU 7  ; dw day number, informational
+DEF OAKLE_CFG_RNG        EQU 9  ; 9 seed bytes for the shared battle RNG list
+DEF OAKLE_CFG_NAME       EQU 18 ; player name, NAME_LENGTH bytes ("@" terminated)
+DEF OAKLE_CFG_PARTY      EQU 29 ; 5 x (species, move1..move4)
+
+OakleConfig::
+	db $4f, $41, $4b, $4c, $45, 1 ; ASCII "OAKLE" + format version (raw bytes, not the game charset)
+	db 1                          ; trainer number: 1 BLASTOISE, 2 VENUSAUR, 3 CHARIZARD
+	dw 1                          ; day
+	db 11, 22, 33, 44, 55, 66, 77, 88, 99 ; RNG seed
+	db "RED@@@@@@@@"              ; player name
+	db ALAKAZAM, PSYCHIC_M, RECOVER, THUNDER_WAVE, SEISMIC_TOSS
+	db SNORLAX,  BODY_SLAM, EARTHQUAKE, HYPER_BEAM, REST
+	db STARMIE,  SURF, BLIZZARD, THUNDERBOLT, RECOVER
+	db CHANSEY,  SOFTBOILED, ICE_BEAM, THUNDERBOLT, THUNDER_WAVE
+	db ZAPDOS,   THUNDERBOLT, DRILL_PECK, THUNDER_WAVE, AGILITY
+OakleConfigEnd::
+
+; Called once from OakleStart, after InitPlayerData2.
+OakleSetup::
+	ld hl, OakleConfig + OAKLE_CFG_NAME
+	ld de, wPlayerName
+	ld bc, NAME_LENGTH
+	call CopyData
+	ld hl, .rivalName
+	ld de, wRivalName
+	ld bc, NAME_LENGTH
+	call CopyData
+
+	ld a, TEXT_DELAY_FAST ; fast text, battle animations on, SHIFT style
+	ld [wOptions], a
+
+	; seed the shared battle RNG (the link-battle list) so every player gets the same dice
+	ld hl, OakleConfig + OAKLE_CFG_RNG
+	ld de, wLinkBattleRandomNumberList
+	ld bc, SERIAL_RNS_LENGTH - 1
+	call CopyData
+	xor a
+	ld [wLinkBattleRandomNumberListIndex], a
+	ld [wUnusedPlayerDataByte], a ; turn counter (was $ff from InitPlayerData2)
+	ld a, [OakleConfig + OAKLE_CFG_TRAINER_NO]
+	ld [wUnusedCardKeyGateID], a ; read back when Oak's battle starts
+
+	; party: 5 mons at Lv 100, max DVs and stat exp, moves straight from the config
+	ld a, $10 ; lower nybble 0 = player party, non-zero = no nickname prompt (reset to 0 below)
+	ld [wMonDataLocation], a
+	ld hl, OakleConfig + OAKLE_CFG_PARTY
+	ld c, 5
+.partyLoop
+	push bc
+	push hl
+	ld a, [hl]
+	ld [wCurPartySpecies], a
+	ld a, 100
+	ld [wCurEnemyLevel], a
+	call AddPartyMon
+	ld hl, wPartyMons
+	ld a, [wPartyCount]
+	dec a
+	ld bc, PARTYMON_STRUCT_LENGTH
+	call AddNTimes ; hl = the mon we just added
+	push hl
+	ld bc, MON_DVS
+	add hl, bc
+	ld a, $ff
+	ld [hli], a
+	ld [hl], a
+	pop hl
+	push hl
+	ld bc, MON_HP_EXP
+	add hl, bc
+	ld b, 2 * NUM_STATS
+.expLoop
+	ld [hli], a
+	dec b
+	jr nz, .expLoop
+	pop hl
+	pop de ; de = config entry (species, moves...)
+	push de
+	push hl
+	inc de
+	ld bc, MON_MOVES
+	add hl, bc
+	push hl ; moves in the party struct
+	ld a, [de]
+	ld [hli], a
+	inc de
+	ld a, [de]
+	ld [hli], a
+	inc de
+	ld a, [de]
+	ld [hli], a
+	inc de
+	ld a, [de]
+	ld [hl], a
+	pop hl ; hl = moves
+	pop de ; de = struct
+	push de
+	push hl
+	ld h, d
+	ld l, e
+	ld bc, MON_PP - 1
+	add hl, bc
+	ld d, h
+	ld e, l ; de = PP - 1 (AddPartyMon_WriteMovePP pre-increments)
+	pop hl
+	call AddPartyMon_WriteMovePP
+	pop hl ; hl = struct
+	push hl
+	ld bc, MON_MAXHP
+	add hl, bc
+	ld d, h
+	ld e, l ; de = stat destination
+	pop hl
+	push hl
+	ld bc, MON_HP_EXP - 1
+	add hl, bc
+	ld b, 1 ; use stat exp
+	call CalcStats
+	pop hl
+	push hl
+	ld bc, MON_MAXHP
+	add hl, bc
+	ld a, [hli]
+	ld d, a
+	ld a, [hl]
+	ld e, a ; max HP
+	pop hl
+	ld bc, MON_HP
+	add hl, bc
+	ld a, d
+	ld [hli], a
+	ld [hl], e ; current HP = max HP
+
+	; nickname = species name (the naming prompt is skipped when wMonDataLocation != 0)
+	ld a, [wCurPartySpecies]
+	ld [wNamedObjectIndex], a
+	call GetMonName
+	ld hl, wPartyMonNicks
+	ld a, [wPartyCount]
+	dec a
+	ld bc, NAME_LENGTH
+	call AddNTimes
+	ld d, h
+	ld e, l
+	ld hl, wNameBuffer
+	ld bc, NAME_LENGTH
+	call CopyData
+	pop hl ; hl = config entry
+	ld bc, 5
+	add hl, bc
+	pop bc
+	dec c
+	jp nz, .partyLoop
+
+	xor a ; PLAYER_PARTY_DATA: LoadMonData & co. treat anything above 3 as the day-care mon
+	ld [wMonDataLocation], a
+
+	SetEvent EVENT_BEAT_CHAMPION_RIVAL
+	ld a, 4 ; SCRIPT_CHAMPIONSROOM_OAK_ARRIVES (not visible outside maps.asm)
+	ld [wChampionsRoomCurScript], a
+	ret
+
+.rivalName:
+	db "GARY@@@@@@@"
+
+; Battle is over (win: wIsInBattle == 0, loss: LOST_BATTLE). Record the result in SRAM bank 3 where the page
+; looks for it, show a closing text and stop. Never returns, so the usual blackout warp never happens.
+DEF OAKLE_SRAM_BANK EQU 1 ; save-data bank: the game only touches it when saving, and not this far up; bank 3 top is scratch
+DEF OAKLE_SRAM_ADDR EQU $bf00 ; "OAKLE", result (1 win / 2 loss), turns, day lo, day hi, party mons still standing
+
+OakleFinish::
+	ld a, [wIsInBattle]
+	inc a ; LOST_BATTLE is $ff
+	ld b, 1 ; win
+	jr nz, .won
+	ld b, 2 ; loss
+.won
+	; d = how many of your Pokemon are still standing
+	ld hl, wPartyMons + MON_HP
+	ld a, [wPartyCount]
+	ld e, a
+	ld d, 0
+.alive
+	ld a, [hli]
+	or [hl] ; HP high | low
+	jr z, .down
+	inc d
+.down
+	ld a, l
+	add PARTYMON_STRUCT_LENGTH - 1
+	ld l, a
+	jr nc, .nextMon
+	inc h
+.nextMon
+	dec e
+	jr nz, .alive
+	ld a, OAKLE_SRAM_BANK
+	call OpenSRAM
+	ld hl, OAKLE_SRAM_ADDR
+	ld a, $4f ; ASCII "OAKLE"
+	ld [hli], a
+	ld a, $41
+	ld [hli], a
+	ld a, $4b
+	ld [hli], a
+	ld a, $4c
+	ld [hli], a
+	ld a, $45
+	ld [hli], a
+	ld a, b
+	ld [hli], a
+	ld a, [wUnusedPlayerDataByte]
+	ld [hli], a
+	ld a, [OakleConfig + OAKLE_CFG_DAY]
+	ld [hli], a
+	ld a, [OakleConfig + OAKLE_CFG_DAY + 1]
+	ld [hli], a
+	ld a, d
+	ld [hl], a
+	call CloseSRAM
+	ld hl, OakleDoneText
+	call PrintText
+.stop
+	halt
+	jr .stop
+
+OakleDoneText:
+	text "Today's battle"
+	line "is over."
+
+	para "Come back"
+	line "tomorrow!"
+	done
diff -ruN pokeyellow-pristine/engine/oakle/oakle_start.asm src/engine/oakle/oakle_start.asm
--- pokeyellow-pristine/engine/oakle/oakle_start.asm	1970-01-01 12:00:00
+++ src/engine/oakle/oakle_start.asm	2026-10-13 10:50:11
@@ -0,0 +1,32 @@
+; Oakle: replaces the title screen / new game speech. Boots straight into the Champion's room
+; (NewGameWarp in data/maps/special_warps.asm) with the daily party from OakleConfig.
+OakleStart::
+	call ClearScreen
+	call LoadTextBoxTilePatterns
+	call PrepareOakSpeech
+	predef InitPlayerData2
+	farcall OakleSetup
+	ld a, [wDefaultMap]
+	ld [wDestinationMap], a
+	call PrepareForSpecialWarp
+	xor a
+	ldh [hTileAnimations], a
+	ld a, PLAYER_DIR_UP
+	ld [wPlayerMovingDirection], a
+	; SpecialEnterMap, inlined: ResetPlayerSpriteData clears the sprite to face south, so set the facing
+	; right after it, otherwise the first frames show RED facing the wrong way
+	xor a
+	ldh [hJoyPressed], a
+	ldh [hJoyHeld], a
+	ldh [hJoy5], a
+	ld [wCableClubDestinationMap], a
+	ld hl, wStatusFlags6
+	set BIT_GAME_TIMER_COUNTING, [hl]
+	call ResetPlayerSpriteData
+	ld a, SPRITE_FACING_UP
+	ld [wSpritePlayerStateData1FacingDirection], a
+	ld [wSpritePlayerStateData1ImageIndex], a ; the picture, too: it is otherwise only refreshed a frame later
+	ld c, 1
+	call DelayFrames
+	call Func_5cc1
+	jp EnterMap
