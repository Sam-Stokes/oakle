diff -ruN -x elm.png pokecrystal-pristine/engine/oakle/oakle.asm src/engine/oakle/oakle.asm
--- pokecrystal-pristine/engine/oakle/oakle.asm	1970-01-01 12:00:00
+++ src/engine/oakle/oakle.asm	2026-11-04 14:43:01
@@ -0,0 +1,200 @@
+; Oakle: daily config (the web page overwrites these bytes in the ROM before boot), party setup and battle finish.
+; Lives in bank 3 next to TryAddMonToParty, FillPP and CalcMonStats.
+
+DEF OAKLE_CFG_TRAINER_NO EQU 6  ; Elm trainer number 1-3 (picks his starter)
+DEF OAKLE_CFG_DAY        EQU 7  ; dw day number, informational
+DEF OAKLE_CFG_RNG        EQU 9  ; SERIAL_RNS_LENGTH (10) seed bytes for the shared battle RNG
+DEF OAKLE_CFG_NAME       EQU 19 ; player name, NAME_LENGTH (11) bytes ("@" terminated)
+DEF OAKLE_CFG_PARTY      EQU 30 ; 6 x (species, move1..move4)
+
+OakleConfig::
+	db $4f, $41, $4b, $4c, $45, 1 ; ASCII "OAKLE" + format version (raw bytes, not the game charset)
+	db 1                          ; trainer number: 1 MEGANIUM, 2 TYPHLOSION, 3 FERALIGATR
+	dw 1                          ; day
+	db 11, 22, 33, 44, 55, 66, 77, 88, 99, 111 ; RNG seed
+	db "GOLD@@@@@@@"              ; player name
+	db ALAKAZAM, PSYCHIC_M,  RECOVER,    THUNDER_WAVE, SEISMIC_TOSS
+	db SNORLAX,  BODY_SLAM,  EARTHQUAKE, HYPER_BEAM,   REST
+	db STARMIE,  SURF,       BLIZZARD,   THUNDERBOLT,  RECOVER
+	db CHANSEY,  SOFTBOILED, ICE_BEAM,   THUNDERBOLT,  THUNDER_WAVE
+	db ZAPDOS,   THUNDERBOLT, DRILL_PECK, THUNDER_WAVE, AGILITY
+	db MEW,      PSYCHIC_M,  RECOVER,    SWIFT,        REFLECT
+OakleConfigEnd::
+
+; Called once from OakleStart, after ResetWRAM.
+OakleSetup::
+	ld hl, OakleConfig + OAKLE_CFG_NAME
+	ld de, wPlayerName
+	ld bc, NAME_LENGTH
+	call CopyBytes
+
+	ld a, TEXT_DELAY_FAST ; fast text, battle animations on, SHIFT style
+	ld [wOptions], a
+
+	; seed the shared battle RNG (the link-battle list) so every player gets the same dice
+	ld hl, OakleConfig + OAKLE_CFG_RNG
+	ld de, wLinkBattleRNs
+	ld bc, SERIAL_RNS_LENGTH
+	call CopyBytes
+	xor a
+	ld [wLinkBattleRNCount], a
+	ld [wUnusedScriptByte], a ; turn counter
+
+	; party: 6 mons at Lv 100, max DVs and stat exp, moves straight from the config
+	xor a ; PARTYMON
+	ld [wMonType], a
+	ld hl, OakleConfig + OAKLE_CFG_PARTY
+	ld c, 6
+.partyLoop
+	push bc
+	push hl
+	ld a, [hl]
+	ld [wCurPartySpecies], a
+	ld a, 100
+	ld [wCurPartyLevel], a
+	call TryAddMonToParty
+	ld hl, wPartyMon1Species
+	ld a, [wPartyCount]
+	dec a
+	ld bc, PARTYMON_STRUCT_LENGTH
+	call AddNTimes ; hl = the mon we just added
+	push hl
+	ld bc, MON_DVS
+	add hl, bc
+	ld a, $ff
+	ld [hli], a
+	ld [hl], a
+	pop hl
+	push hl
+	ld bc, MON_STAT_EXP
+	add hl, bc
+	ld a, $ff
+	ld b, NUM_EXP_STATS * 2
+.expLoop
+	ld [hli], a
+	dec b
+	jr nz, .expLoop
+	pop hl ; struct
+	pop de ; config entry (species, moves...)
+	push de
+	inc de
+	push hl
+	ld bc, MON_MOVES
+	add hl, bc
+	ld b, NUM_MOVES
+.moveLoop
+	ld a, [de]
+	inc de
+	ld [hli], a
+	dec b
+	jr nz, .moveLoop
+	pop hl ; struct
+	push hl
+	ld bc, MON_PP
+	add hl, bc
+	ld d, h
+	ld e, l ; de = PP
+	pop hl
+	push hl
+	ld bc, MON_MOVES
+	add hl, bc
+	call FillPP
+	pop hl ; struct
+	push hl
+	ld bc, MON_MAXHP
+	add hl, bc
+	ld d, h
+	ld e, l ; de = stat destination
+	pop hl
+	push hl
+	ld bc, MON_STAT_EXP - 1
+	add hl, bc
+	ld b, TRUE ; use stat exp
+	call CalcMonStats
+	pop hl ; struct
+	push hl
+	ld bc, MON_MAXHP
+	add hl, bc
+	ld a, [hli]
+	ld d, a
+	ld e, [hl] ; max HP
+	pop hl
+	ld bc, MON_HP
+	add hl, bc
+	ld a, d
+	ld [hli], a
+	ld [hl], e ; current HP = max HP
+	pop hl ; config entry
+	ld bc, 5
+	add hl, bc
+	pop bc
+	dec c
+	jp nz, .partyLoop
+	ret
+
+; Elm's variant (his starter) from the config. Runs after loadtrainer in his script.
+OakleLoadElm::
+	ld a, [OakleConfig + OAKLE_CFG_TRAINER_NO]
+	ld [wOtherTrainerID], a
+	ret
+
+; Battle is over (wScriptVar = battle result: WIN, LOSE...). Record the result in SRAM bank 0 where the page looks for it.
+DEF OAKLE_SRAM_BANK EQU 0 ; nothing is mapped between $ac6b and $b1ff in bank 0
+DEF OAKLE_SRAM_ADDR EQU $b000 ; "OAKLE", result (1 win / 2 loss), turns, day lo, day hi, party mons still standing
+
+OakleFinish::
+	ld a, [wScriptVar]
+	and a ; WIN is 0
+	ld b, 1 ; win
+	jr z, .won
+	ld b, 2 ; loss
+.won
+	; d = how many of your Pokemon are still standing
+	ld hl, wPartyMon1HP
+	ld a, [wPartyCount]
+	ld e, a
+	ld d, 0
+.alive
+	ld a, [hli]
+	or [hl] ; HP high | low
+	jr z, .down
+	inc d
+.down
+	ld a, PARTYMON_STRUCT_LENGTH - 1
+	add l
+	ld l, a
+	jr nc, .nextMon
+	inc h
+.nextMon
+	dec e
+	jr nz, .alive
+	ld a, OAKLE_SRAM_BANK
+	call OpenSRAM
+	ld hl, OAKLE_SRAM_ADDR
+	ld a, $4f ; ASCII "OAKLE"
+	ld [hli], a
+	ld a, $41
+	ld [hli], a
+	ld a, $4b
+	ld [hli], a
+	ld a, $4c
+	ld [hli], a
+	ld a, $45
+	ld [hli], a
+	ld a, b
+	ld [hli], a
+	ld a, [wUnusedScriptByte]
+	ld [hli], a
+	ld a, [OakleConfig + OAKLE_CFG_DAY]
+	ld [hli], a
+	ld a, [OakleConfig + OAKLE_CFG_DAY + 1]
+	ld [hli], a
+	ld a, d
+	ld [hl], a
+	jp CloseSRAM
+
+; Never returns, so Elm cannot be fought twice.
+OakleHalt::
+.stop
+	halt
+	jr .stop
