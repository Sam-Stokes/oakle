diff -ruN pokeemerald-pristine/src/oakle.c src/src/oakle.c
--- pokeemerald-pristine/src/oakle.c	1970-01-01 12:00:00
+++ src/src/oakle.c	2026-11-08 16:42:58
@@ -0,0 +1,147 @@
+// Oakle: daily config, party setup, the fight with Prof. Birch, and the result record. The web page patches OakleConfig
+// in the ROM file before boot; everything else is the real game. No new RAM variables on purpose: gPlayerParty and friends
+// must stay where src/games.ts reads them.
+#include "global.h"
+#include "oakle.h"
+#include "agb_flash.h"
+#include "gba/m4a_internal.h"
+#include "battle.h"
+#include "battle_setup.h"
+#include "load_save.h"
+#include "malloc.h"
+#include "new_game.h"
+#include "pokemon.h"
+#include "random.h"
+#include "save.h"
+#include "sound.h"
+#include "constants/battle.h"
+#include "constants/global.h"
+#include "constants/moves.h"
+#include "constants/opponents.h"
+#include "constants/pokemon.h"
+#include "constants/species.h"
+#include "event_data.h"
+#include "constants/flags.h"
+#include "overworld.h"
+#include "main.h"
+#include "strings.h"
+
+// Byte layout (must match src/games.ts cfg and src/rom.ts patchRom):
+//   0 "OAKLE", 5 version, 6 trainer 1-3 (picks Birch's starter), 7 day (u16), 9 RNG seed (4 bytes), 13 player name (8 bytes),
+//   21 party: 6 x (species u16, move1..move4 u16, ability slot u8) = 11 bytes each
+#define CFG_TRAINER 6
+#define CFG_DAY     7
+#define CFG_RNG     9
+#define CFG_NAME    13
+#define CFG_PARTY   21
+#define CFG_ENTRY   11
+
+#define U16(v) ((v) & 0xff), ((v) >> 8)
+#define MON(species, m1, m2, m3, m4, ability) U16(species), U16(m1), U16(m2), U16(m3), U16(m4), ability
+
+const u8 OakleConfig[] = {
+    'O', 'A', 'K', 'L', 'E', 1,
+    1,                          // trainer: 1 Sceptile, 2 Blaziken, 3 Swampert
+    U16(1),                     // day
+    11, 22, 33, 44,             // RNG seed
+    0xce, 0xbf, 0xcd, 0xce, 0xff, 0xff, 0xff, 0xff, // "TEST"
+    MON(SPECIES_GARDEVOIR, MOVE_PSYCHIC, MOVE_THUNDERBOLT, MOVE_SHADOW_BALL, MOVE_CALM_MIND, 0),
+    MON(SPECIES_SNORLAX, MOVE_BODY_SLAM, MOVE_EARTHQUAKE, MOVE_HYPER_BEAM, MOVE_REST, 0),
+    MON(SPECIES_STARMIE, MOVE_SURF, MOVE_ICE_BEAM, MOVE_THUNDERBOLT, MOVE_RECOVER, 0),
+    MON(SPECIES_BLISSEY, MOVE_SOFT_BOILED, MOVE_ICE_BEAM, MOVE_THUNDERBOLT, MOVE_THUNDER_WAVE, 0),
+    MON(SPECIES_ZAPDOS, MOVE_THUNDERBOLT, MOVE_DRILL_PECK, MOVE_THUNDER_WAVE, MOVE_AGILITY, 0),
+    MON(SPECIES_MEW, MOVE_PSYCHIC, MOVE_RECOVER, MOVE_SWIFT, MOVE_REFLECT, 0),
+};
+
+// Boots straight into a new game, in place of the copyright screen, title screen and intro.
+void CB2_OakleBoot(void)
+{
+    // the same start-up the copyright screen does before the title screen
+    SetSaveBlocksPointers(GetSaveBlocksPointersBaseOffset());
+    ResetMenuAndMonGlobals();
+    Save_ResetSaveCounters();
+    LoadGameSave(SAVE_NORMAL);
+    if (gSaveFileStatus == SAVE_STATUS_EMPTY || gSaveFileStatus == SAVE_STATUS_CORRUPT)
+        Sav2_ClearSetDefault();
+    SetPokemonCryStereo(gSaveBlock2Ptr->optionsSound);
+    InitHeap(gHeap, HEAP_SIZE);
+    SetMainCallback2(CB2_NewGame); // which ends in NewGameInitData -> OakleNewGame, and the Champion's room (new_game.c)
+}
+
+// The end of NewGameInitData: who the player is and what they bring.
+void OakleNewGame(void)
+{
+    s32 i, j;
+
+    for (i = 0; i < PLAYER_NAME_LENGTH + 1; i++)
+        gSaveBlock2Ptr->playerName[i] = OakleConfig[CFG_NAME + i];
+    gSaveBlock2Ptr->playerGender = MALE;
+    // The team's OT ID is 0 (below), so the player's must be 0 too: otherwise every Pokemon counts as traded and, at Lv 100
+    // with no badges, "is loafing around" instead of obeying. (A fixed ID also keeps them from ever being shiny.)
+    for (i = 0; i < TRAINER_ID_LENGTH; i++)
+        gSaveBlock2Ptr->playerTrainerId[i] = 0;
+    gSaveBlock2Ptr->optionsTextSpeed = OPTIONS_TEXT_SPEED_FAST;
+    gSaveBlock2Ptr->optionsBattleSceneOff = FALSE;
+    gSaveBlock2Ptr->optionsBattleStyle = OPTIONS_BATTLE_STYLE_SHIFT;
+    FlagSet(FLAG_SYS_POKEMON_GET); // the START menu offers the team screen only with this
+
+    // six Lv 100 Pokemon: all IVs 31, no EVs, no items, Hardy (neutral nature), male where the species has genders, never shiny.
+    // The personality picks nature, gender and the ability slot: 225 and 250 are both multiples of 25 (Hardy), with an
+    // odd / even low bit for ability slot 1 / 0 and a high low byte (male).
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        const u8 *e = &OakleConfig[CFG_PARTY + i * CFG_ENTRY];
+        u16 species = e[0] | (e[1] << 8);
+
+        CreateMon(&gPlayerParty[i], species, 100, 31, TRUE, e[10] ? 225 : 250, OT_ID_PRESET, 0);
+        for (j = 0; j < MAX_MON_MOVES; j++)
+            SetMonMoveSlot(&gPlayerParty[i], e[2 + j * 2] | (e[3 + j * 2] << 8), j);
+    }
+    CalculatePlayerPartyCount();
+}
+
+// The fight starts (BattleSetup_StartTrainerBattle): the shared dice, seeded only now so that the time spent in the room
+// cannot change them; from here on nothing but the battle itself advances the generator (see the VBlanks in main.c and
+// battle_main.c).
+void OakleSeedDice(void)
+{
+    gRngValue = OakleConfig[CFG_RNG] | (OakleConfig[CFG_RNG + 1] << 8) | (OakleConfig[CFG_RNG + 2] << 16) | ((u32)OakleConfig[CFG_RNG + 3] << 24);
+}
+
+// The room has one Birch (TRAINER_BIRCH_1); the day's config says which starter he brings.
+u16 OakleTrainerVariant(u16 trainerNum)
+{
+    return trainerNum == TRAINER_BIRCH_1 ? TRAINER_BIRCH_1 + OakleConfig[CFG_TRAINER] - 1 : trainerNum;
+}
+
+// What Birch says when the fight is over (battle_setup.c prints these in place of a trainer's speeches).
+const u8 gOakleDefeatText[] = _("BIRCH: Hmm! Well played,\n{PLAYER}!");
+const u8 gOakleVictoryText[] = _("BIRCH: Not yet! Try again\ntomorrow.");
+
+void CB2_OakleHold(void)
+{
+    // the battle is over and its result is written: nothing more happens (the page shows its win or loss screen)
+}
+
+// Called when the battle's own text is finished, because the page shows its result screen within half a second of this
+// appearing: "OAKLE", 1 win / 2 loss, turns, day lo, day hi, party mons still standing.
+void OakleRecordResult(void)
+{
+    u8 *b = AllocZeroed(SECTOR_SIZE);
+    u8 alive = 0;
+    s32 i;
+
+    if (b == NULL)
+        return;
+    for (i = 0; i < PARTY_SIZE; i++)
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES) != SPECIES_NONE && GetMonData(&gPlayerParty[i], MON_DATA_HP) != 0)
+            alive++;
+    b[0] = 'O'; b[1] = 'A'; b[2] = 'K'; b[3] = 'L'; b[4] = 'E';
+    b[5] = gBattleOutcome == B_OUTCOME_WON ? 1 : 2;
+    b[6] = gBattleResults.battleTurnCounter;
+    b[7] = OakleConfig[CFG_DAY];
+    b[8] = OakleConfig[CFG_DAY + 1];
+    b[9] = alive;
+    ProgramFlashSectorAndVerify(OAKLE_RESULT_SECTOR, b);
+    Free(b);
+}
